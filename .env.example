# Leave empty to use the offline mock vision adapter (default).
ANTHROPIC_API_KEY=
# Optional overrides when using Anthropic
PIXELBLAME_MODEL=claude-sonnet-5-5
PIXELBLAME_PRICE_IN=3
PIXELBLAME_PRICE_OUT=15
# Force the mock even if a key is set
# PIXELBLAME_ADAPTER=mock
# Where runs, blobs and calibration are stored
PIXELBLAME_DATA=data
PORT=4317
